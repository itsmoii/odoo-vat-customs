<odoo>
  <data noupdate="0">
    <!-- Define a tax group for FRCS VAT -->
    <record id="tax_group_frcs_vat" model="account.tax.group">
      <field name="name">FRCS VAT</field>
    </record>

    <!-- FRCS Sales Taxes -->
    <record id="tax_sale_frcs_0" model="account.tax">
      <field name="name">FRCS VAT 0% (Sales)</field>
      <field name="type_tax_use">sale</field>
      <field name="amount_type">percent</field>
      <field name="amount">0.0</field>
      <field name="tax_group_id" ref="tax_group_frcs_vat"/>
      <field name="price_include">0</field>
      <field name="active">1</field>
    </record>
    <record id="tax_sale_frcs_125" model="account.tax">
      <field name="name">FRCS VAT 12.5% (Sales)</field>
      <field name="type_tax_use">sale</field>
      <field name="amount_type">percent</field>
      <field name="amount">12.5</field>
      <field name="tax_group_id" ref="tax_group_frcs_vat"/>
      <field name="price_include">0</field>
      <field name="active">1</field>
    </record>

    <!-- FRCS Purchase Taxes -->
    <record id="tax_purchase_frcs_0" model="account.tax">
      <field name="name">FRCS VAT 0% (Purchase)</field>
      <field name="type_tax_use">purchase</field>
      <field name="amount_type">percent</field>
      <field name="amount">0.0</field>
      <field name="tax_group_id" ref="tax_group_frcs_vat"/>
      <field name="price_include">0</field>
      <field name="active">1</field>
    </record>
    <record id="tax_purchase_frcs_125" model="account.tax">
      <field name="name">FRCS VAT 12.5% (Purchase)</field>
      <field name="type_tax_use">purchase</field>
      <field name="amount_type">percent</field>
      <field name="amount">12.5</field>
      <field name="tax_group_id" ref="tax_group_frcs_vat"/>
      <field name="price_include">0</field>
      <field name="active">1</field>
    </record>
  </data>
</odoo>
