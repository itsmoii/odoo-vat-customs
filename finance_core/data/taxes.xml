<odoo>
    <data>
        <!-- VAT 0% (Sales) -->
        <record id="tax_vat_0" model="account.tax">
            <field name="name">VAT 0%</field>
            <field name="type_tax_use">sale</field>
            <field name="amount_type">percent</field>
            <field name="amount">0.0</field>
            <field name="price_include" eval="False"/>
            <field name="active" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- VAT 12.5% (Sales) -->
        <record id="tax_vat_125" model="account.tax">
            <field name="name">VAT 12.5%</field>
            <field name="type_tax_use">sale</field>
            <field name="amount_type">percent</field>
            <field name="amount">12.5</field>
            <field name="price_include" eval="False"/>
            <field name="active" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Purchase VAT 0% (Supplier side) - archived to avoid duplicates with FRCS Purchase taxes -->
        <record id="tax_purchase_vat_0" model="account.tax">
            <field name="name">Purchase VAT 0%</field>
            <field name="type_tax_use">purchase</field>
            <field name="amount_type">percent</field>
            <field name="amount">0.0</field>
            <field name="price_include" eval="False"/>
            <field name="active" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Purchase VAT 12.5% (Supplier side) - archived to avoid duplicates with FRCS Purchase taxes -->
        <record id="tax_purchase_vat_125" model="account.tax">
            <field name="name">Purchase VAT 12.5%</field>
            <field name="type_tax_use">purchase</field>
            <field name="amount_type">percent</field>
            <field name="amount">12.5</field>
            <field name="price_include" eval="False"/>
            <field name="active" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>

