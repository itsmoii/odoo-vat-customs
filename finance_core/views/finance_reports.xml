<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Simple Finance Report Tree View -->
    <record id="view_finance_report_tree" model="ir.ui.view">
        <field name="name">finance.report.tree</field>
        <field name="model">finance.report</field>
        <field name="arch" type="xml">
            <list string="Finance Reports">
                <field name="name"/>
                <field name="date"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <!-- Finance Report Form View -->
    <record id="view_finance_report_form" model="ir.ui.view">
        <field name="name">finance.report.form</field>
        <field name="model">finance.report</field>
        <field name="arch" type="xml">
            <form string="Finance Report">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="total_amount"/>
                        <field name="details"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
