<odoo>
    <!-- Search view for Finance Transactions (avoid action domain functions) -->
    <record id="view_finance_transaction_search" model="ir.ui.view">
        <field name="name">finance.transaction.search</field>
        <field name="model">finance.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Transactions">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <filter name="income" string="Income" domain="[('transaction_type', '=', 'income')]"/>
                <filter name="expense" string="Expense" domain="[('transaction_type', '=', 'expense')]"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today())]"/>
            </search>
        </field>
    </record>
    <!-- Tree (list) view for Finance Transactions -->
    <record id="view_finance_transaction_tree" model="ir.ui.view">
        <field name="name">finance.transaction.tree</field>
        <field name="model">finance.transaction</field>
        <field name="arch" type="xml">
            <list string="Finance Transactions">
                <field name="name"/>
                <field name="transaction_type"/>
                <field name="amount" sum="Total"/>
                <field name="vat_amount" sum="VAT Total"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="pos_order_id"/>
                <field name="stock_move_id"/>
            </list>
        </field>
    </record>

    <!-- Form view for Finance Transactions -->
    <record id="view_finance_transaction_form" model="ir.ui.view">
        <field name="name">finance.transaction.form</field>
        <field name="model">finance.transaction</field>
        <field name="arch" type="xml">
            <form string="Finance Transaction">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="transaction_type"/>
                        <field name="amount"/>
                        <field name="vat_amount"/>
                        <field name="date"/>
                        <field name="partner_id"/>
                        <field name="pos_order_id" readonly="1"/>
                        <field name="stock_move_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
