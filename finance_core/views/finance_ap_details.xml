<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Search view for Accounts Payable Details (Vendor Bills) -->
    <record id="view_finance_ap_search" model="ir.ui.view">
        <field name="name">finance.accounts.payable.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Accounts Payable">
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <filter name="vendor_bills" string="Vendor Bills" domain="[('move_type','=','in_invoice')]"/>
                <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="ap_unpaid" string="Unpaid/Partial" domain="[('payment_state','!=','paid')]"/>
                <filter name="ap_overdue" string="Overdue" domain="[('invoice_date_due','&lt;', context_today()), ('payment_state','!=','paid')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vendor" string="Vendor" context="{'group_by':'partner_id'}"/>
                    <filter name="group_due" string="Due Date" context="{'group_by':'invoice_date_due'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action to open AP Details -->
    <record id="action_finance_ap_details" model="ir.actions.act_window">
        <field name="name">Accounts Payable</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="finance_core.view_finance_ap_search"/>
        <field name="context">{"search_default_vendor_bills":1, "search_default_posted":1, "search_default_ap_unpaid":1}</field>
    </record>

    <!-- Menu for AP Details (align with accounts payable item) -->
    <menuitem id="menu_finance_ap_details" name="Overview" parent="finance_core.menu_finance_ap_root" action="action_finance_ap_details" sequence="0" groups="base.group_user"/>
</odoo>
