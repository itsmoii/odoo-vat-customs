<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- =======================
         FINANCE MAIN MENU
         ======================= -->
    <menuitem id="menu_finance_root" name="Finance" sequence="10" groups="base.group_user"/>

    <!-- Sales dropdown -->
    <menuitem id="menu_finance_sales_root" name="Sales"
              parent="menu_finance_root"
              sequence="1"
              groups="base.group_user"/>

    <!-- =======================
         ACTIONS AND MENUS
         ======================= -->

    <!-- ❌ Disabled until model 'finance.transaction' is created -->
    <!--
    <record id="action_finance_transactions" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">finance.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new transaction.
            </p>
        </field>
    </record>
    -->

    <!-- ❌ Disabled until model 'finance.report' is created -->
    <!--
    <record id="action_finance_reports" model="ir.actions.act_window">
        <field name="name">Finance Reports</field>
        <field name="res_model">finance.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_finance_daily_pos_sales" model="ir.actions.act_window">
        <field name="name">Daily POS Sales</field>
        <field name="res_model">finance.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="False"/>
        <field name="context">{ "search_default_today": 1, "search_default_income": 1 }</field>
    </record>
    -->

    <!-- Accounts Payable: open vendor bills not paid -->
    <record id="action_finance_accounts_payable" model="ir.actions.act_window">
        <field name="name">Accounts Payable</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[["move_type","=","in_invoice"],["payment_state","!=","paid"],["state","=","posted"]]</field>
        <field name="context">{"search_default_unpaid": 1}</field>
    </record>

    <!-- Top Selling Products: analyze POS order lines -->
    <record id="action_finance_top_products" model="ir.actions.act_window">
        <field name="name">Top Selling Products</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{"graph_measure":"qty","searchpanel_default_product_id":1}</field>
    </record>

    <record id="action_finance_vendor_bills_paid" model="ir.actions.act_window">
        <field name="name">Vendor Bills - Paid</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[["move_type","=","in_invoice"],["payment_state","=","paid"],["state","=","posted"]]</field>
    </record>

    <!-- Menuitems referencing actions defined above -->
    <!-- Keep menu placeholder without action for now -->
    <menuitem id="menu_finance_daily_pos_sales"
              name="Daily POS Sales"
              parent="menu_finance_sales_root"
              sequence="1"
              groups="base.group_user"/>

    <!-- Accounts Payable dropdown root -->
    <menuitem id="menu_finance_ap_root" name="Accounts Payable" parent="menu_finance_root" sequence="2" groups="base.group_user"/>

    <!-- AP: Bills (all), Unpaid (default), Paid, Refunds, Payments, Vendors, Products -->
    <record id="action_finance_ap_bills_all" model="ir.actions.act_window">
        <field name="name">Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[["move_type","=","in_invoice"]]</field>
    </record>
    <menuitem id="menu_finance_ap_bills_all" name="Bills" parent="menu_finance_ap_root" action="action_finance_ap_bills_all" sequence="1" groups="base.group_user"/>

    <menuitem id="menu_finance_accounts_payable" name="Unpaid / Partial" parent="menu_finance_ap_root" action="action_finance_accounts_payable" sequence="2" groups="base.group_user"/>

    <menuitem id="menu_finance_vendor_bills_paid" name="Paid" parent="menu_finance_ap_root" action="action_finance_vendor_bills_paid" sequence="3" groups="base.group_user"/>

    <record id="action_finance_ap_refunds" model="ir.actions.act_window">
        <field name="name">Refunds</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[["move_type","=","in_refund"]]</field>
    </record>
    <menuitem id="menu_finance_ap_refunds" name="Refunds" parent="menu_finance_ap_root" action="action_finance_ap_refunds" sequence="4" groups="base.group_user"/>

    <record id="action_finance_ap_payments" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[["partner_type","=","supplier"]]</field>
    </record>
    <menuitem id="menu_finance_ap_payments" name="Payments" parent="menu_finance_ap_root" action="action_finance_ap_payments" sequence="5" groups="base.group_user"/>

    <record id="action_finance_ap_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[["purchase_ok","=",True]]</field>
    </record>
    <menuitem id="menu_finance_ap_products" name="Products" parent="menu_finance_ap_root" action="action_finance_ap_products" sequence="6" groups="base.group_user"/>

    <record id="action_finance_ap_vendors" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[["supplier_rank",">",0]]</field>
    </record>
    <menuitem id="menu_finance_ap_vendors" name="Vendors" parent="menu_finance_ap_root" action="action_finance_ap_vendors" sequence="7" groups="base.group_user"/>

    <!-- ❌ Disabled invalid menus until actions are re-enabled -->
    <!--
    <menuitem id="menu_finance_transactions" name="Transactions"
              parent="menu_finance_root" action="action_finance_transactions"
              sequence="10" groups="base.group_user"/>
    <menuitem id="menu_finance_reports" name="Reports"
              parent="menu_finance_root" action="action_finance_reports"
              sequence="11" groups="base.group_user"/>
    -->
    <menuitem id="menu_finance_top_products" name="Top Selling Products" parent="menu_finance_sales_root" action="action_finance_top_products" sequence="3" groups="base.group_user"/>
</odoo>
