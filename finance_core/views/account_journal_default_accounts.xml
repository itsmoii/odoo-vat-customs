<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_account_journal_form_inherit_default_accounts" model="ir.ui.view">
      <field name="name">account.journal.form.default.accounts</field>
      <field name="model">account.journal</field>
      <field name="inherit_id" ref="account.view_account_journal_form"/>
      <field name="arch" type="xml">
        <xpath expr="//sheet/notebook" position="inside">
          <page string="Default Accounts" name="default_accounts">
            <group>
              <field name="default_debit_account_id"/>
              <field name="default_credit_account_id"/>
            </group>
          </page>
        </xpath>
      </field>
    </record>
  </data>
  
</odoo>

